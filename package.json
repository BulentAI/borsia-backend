{
  "name": "borsia-backend",
  "version": "1.0.0",
  "description": "BORSiA — AI-powered finance analysis SaaS backend",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "npx prisma generate && npx prisma db push",
    "postinstall": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "prisma": "^6.4.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "connect-pg-simple": "^10.0.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2",
    "node-fetch": "^2.7.0"
  }
}
